# Docker Compose Environment Variables
# Copy this file to .env and update with your actual values

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
POSTGRES_DB=dolce_fiore
POSTGRES_USER=dolce_user
POSTGRES_PASSWORD=dolce_password
POSTGRES_PORT=5432

# ============================================
# Django Backend Configuration
# ============================================
# Django Environment: 'development' or 'production'
DJANGO_ENV=development

# Secret Key (REQUIRED - generate a secure random string)
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Debug Mode (True for development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated list)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS Allowed Origins (comma-separated list)
# Include frontend URL and Docker service name
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://frontend:5173

# ============================================
# Frontend Configuration
# ============================================
# API Base URL (for Vite environment variable)
# In Docker, use the backend service name
VITE_API_BASE_URL=http://backend:8000/api

# Use Mock API (true/false)
VITE_USE_MOCK_API=false

# ============================================
# Port Configuration
# ============================================
# Backend Port
BACKEND_PORT=8000

# Frontend Port
FRONTEND_PORT=5173

# ============================================
# Production Overrides (uncomment for production)
# ============================================
# DJANGO_ENV=production
# DEBUG=False
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
