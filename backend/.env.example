# Django Backend Environment Variables
# Copy this file to .env and update with your actual values

# ============================================
# Required: Django Secret Key
# ============================================
# Generate a secret key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# ============================================
# Django Settings
# ============================================
DJANGO_ENV=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ============================================
# Database Configuration
# ============================================
# For SQLite (default, no DB needed):
# Leave DB_NAME empty or unset

# For PostgreSQL (when using docker-compose):
DB_NAME=dolce_fiore
DB_USER=dolce_user
DB_PASSWORD=dolce_password
DB_HOST=db
DB_PORT=5432

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://frontend:5173
